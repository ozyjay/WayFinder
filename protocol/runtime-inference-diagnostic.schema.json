{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wayfinder.local/protocol/runtime-inference-diagnostic.schema.json",
  "title": "WayFinder owned-runtime inference diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp", "iteration", "executionMode", "modelTier", "phase", "contextItemTypes", "contextProvenance",
    "contextCharactersByType", "inputBudget", "outputBudget", "exposedToolCount",
    "exposedToolSchemaBytes", "stablePrefixId", "latencyMs", "outcome"
  ],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "iteration": { "type": "integer", "minimum": 0 },
    "executionMode": { "enum": ["auto", "fast", "deep"] },
    "modelTier": { "enum": ["fast", "deep"] },
    "phase": { "enum": ["initialising", "planning", "acting", "observing", "awaiting-approval", "completed", "cancelled", "failed", "stopped"] },
    "contextItemTypes": { "type": "array", "items": { "enum": ["goal", "instruction", "evidence", "code", "selection", "failure"] } },
    "contextProvenance": { "type": "array", "items": { "type": "string", "maxLength": 280 } },
    "contextCharactersByType": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "inputBudget": { "$ref": "#/$defs/tokenBudget" },
    "outputBudget": { "$ref": "#/$defs/tokenBudget" },
    "exposedToolCount": { "type": "integer", "minimum": 0 },
    "exposedToolSchemaBytes": { "type": "integer", "minimum": 0 },
    "stablePrefixId": { "type": "string", "maxLength": 280 },
    "latencyMs": { "type": "integer", "minimum": 0 },
    "outcome": { "enum": ["final", "tool-request", "validation-rejected", "approval-required", "cancelled", "stopped", "failed"] },
    "validationCode": { "enum": ["unknown-tool", "malformed-arguments", "unsupported-response", "insufficient-evidence-coverage", "recoverable-tool-error"] },
    "failureCode": { "enum": ["backend-error", "tool-execution-error"] },
    "escalation": { "enum": ["fast-to-deep"] },
    "stopReason": { "enum": ["iteration-limit", "cancelled", "validation-limit", "tool-rejected"] },
    "modelDeckDiscovery": { "$ref": "#/$defs/modelDeckDiscovery" }
  },
  "$defs": {
    "tokenBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "countKind"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1 },
        "countKind": { "enum": ["authoritative", "estimate"] }
      }
    },
    "modelDeckDiscovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "configuredWorker"],
      "properties": {
        "source": { "enum": ["explicit", "legacy"] },
        "route": { "$ref": "#/$defs/modelDeckRoute" },
        "configuredWorker": { "$ref": "#/$defs/modelDeckWorker" },
        "selectedWorker": { "$ref": "#/$defs/modelDeckWorker" },
        "selectionReason": { "enum": ["primary_ready", "backup_ready", "no_ready_worker"] }
      }
    },
    "modelDeckRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicModelId": { "type": "string" },
        "capabilityId": { "type": "string" },
        "routingProfileId": { "type": "string" },
        "routingProfileRevision": { "type": "string" }
      }
    },
    "modelDeckWorker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workerId": { "type": "string" },
        "modelId": { "type": "string" },
        "revision": { "type": "string" },
        "baseModelId": { "type": "string" },
        "baseModelRevision": { "type": "string" },
        "artefactId": { "type": "string" },
        "artefactRevision": { "type": "string" },
        "runtime": { "type": "string" },
        "accelerator": { "type": "string" },
        "configurationFingerprint": { "type": "string" },
        "runtimeConfigurationFingerprint": { "type": "string" }
      }
    }
  }
}
